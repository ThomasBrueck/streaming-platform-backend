# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
#
#   cp .env.example .env

# Secret used to sign/verify JWTs (auth-service signs, api-gateway verifies).
# REQUIRED. Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# Password shared by the local PostgreSQL containers (dev only).
DB_PASSWORD=123

# LiveKit (WebRTC SFU) credentials. These MUST match the `keys:` and
# `webhook.api_key` entries in livekit.yaml — the defaults below already do.
# The secret must be >= 32 bytes (256 bits) — HS256 rejects shorter keys.
# For a real deployment: generate real keys, put them here, AND update
# livekit.yaml (or use LiveKit Cloud) to match.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-for-local-development-only-not-for-prod

# WebSocket URL the BROWSER uses to reach LiveKit (published port on the host).
LIVEKIT_WS_URL=ws://localhost:7880

# CORS origin allowed by the API gateway (defaults to the Vite dev server).
CORS_ALLOWED_ORIGIN=http://localhost:5173
